{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "vqa_service/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/vqa/py/(.*)", "dest": "vqa_service/main.py" },
    { "src": "/api/(.*)", "dest": "backend/index.js" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}